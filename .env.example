# 12th Bihar Board Telegram Bot Configuration
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Multi-Agent 1: Google Gemini 3.5 Flash (Free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_API_KEY_BACKUP=YOUR_BACKUP_GEMINI_KEY_HERE

# Multi-Agent 2: ChatGPT (OpenAI)
CHATGPT_API_KEY=YOUR_OPENAI_KEY_HERE
CHATGPT_API_KEY_BACKUP=YOUR_BACKUP_OPENAI_KEY_HERE

# Multi-Agent 3: DeepSeek v3.1 (Bedrock Mantle / OpenAI-Compatible)
OPENAI_API_KEY=YOUR_MANTLE_KEY_HERE
OPENAI_API_KEY_BACKUP=YOUR_BACKUP_MANTLE_KEY_HERE
OPENAI_BASE_URL=https://bedrock-mantle.ap-southeast-2.api.aws/v1
AI_MODEL=deepseek.v3.1

# Optional Settings
DEFAULT_QUESTIONS_PER_QUIZ=100
AUTO_NEXT_DELAY_SECONDS=3
ADMIN_ID=0
